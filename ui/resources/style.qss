/* Smart Accounting Platform — Light Theme (Material Design 3) */
/* ============================================================= */

/* ----- Global ----- */
QMainWindow {
    background-color: #F8FAFC;
}
QWidget {
    font-family: "Segoe UI", "Tahoma", "Arial", sans-serif;
    font-size: 13px;
    color: #1E293B;
}

/* ----- Top Header Bar ----- */
#headerBar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1E40AF, stop:1 #3B82F6);
    min-height: 52px;
    max-height: 52px;
    border-bottom: 2px solid #1D4ED8;
    padding: 0 16px;
}
#headerBar QLabel {
    color: #FFFFFF;
    font-size: 16px;
    font-weight: bold;
}
#headerBar QLabel#headerSub {
    color: rgba(255,255,255,0.85);
    font-size: 11px;
    font-weight: normal;
}

/* ----- Sidebar ----- */
#sidebar {
    background: #F1F5F9;
    border: none;
    border-right: 1px solid #E2E8F0;
    padding: 8px 4px;
    font-size: 13px;
    outline: none;
}
#sidebar::item {
    padding: 8px 12px;
    margin: 1px 6px;
    border-radius: 8px;
    color: #334155;
    min-height: 20px;
}
#sidebar::item:hover {
    background-color: #E2E8F0;
    color: #1E293B;
}
#sidebar::item:selected {
    background-color: #DBEAFE;
    color: #1D4ED8;
    font-weight: bold;
    border-left: 3px solid #3B82F6;
}

/* ----- Ribbon (شريط واحد: تبويبات + أزرار) ----- */
#ribbonWidget {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E2E8F0;
    min-height: 48px;
    max-height: 48px;
}
#ribbonTabs {
    background: transparent;
    border: none;
    padding: 0 8px;
    font-size: 12px;
    outline: none;
}
#ribbonTabs::tab {
    background: transparent;
    color: #475569;
    padding: 5px 14px;
    border: none;
    border-bottom: 3px solid transparent;
    margin: 2px 0;
    min-height: 34px;
}
#ribbonTabs::tab:hover {
    background-color: #F1F5F9;
    color: #1E293B;
}
#ribbonTabs::tab:selected {
    color: #1D4ED8;
    font-weight: bold;
    border-bottom: 3px solid #3B82F6;
}
#ribbonBtn {
    background: transparent;
    border: none;
    border-radius: 8px;
    color: #334155;
    font-size: 11px;
    padding: 2px 8px;
}
#ribbonBtn:hover {
    background-color: #E2E8F0;
    color: #1E293B;
}
#ribbonBtn:pressed {
    background-color: #DBEAFE;
    color: #1D4ED8;
}

/* ----- Content Area ----- */
#contentStack {
    background-color: #F8FAFC;
}

/* ----- Cards ----- */
QFrame#card {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    padding: 12px;
}
QFrame#card:hover {
    border-color: #CBD5E1;
}

/* ----- Headers ----- */
#headerTitle {
    font-size: 22px;
    font-weight: bold;
    color: #1E293B;
    padding: 4px 0 2px 0;
}
#headerSubtitle {
    font-size: 13px;
    color: #64748B;
    padding: 0 0 12px 0;
}
#cardTitle {
    font-size: 14px;
    font-weight: bold;
    color: #1E293B;
    padding-bottom: 6px;
}

/* ----- Stat Cards ----- */
#statValue {
    font-size: 22px;
    font-weight: bold;
    color: #3B82F6;
}

/* ----- Buttons ----- */
QPushButton {
    background-color: #F1F5F9;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 8px 18px;
    min-height: 40px;
    color: #334155;
    font-weight: 500;
}
QPushButton:hover {
    background-color: #E2E8F0;
    border-color: #94A3B8;
}
QPushButton:pressed {
    background-color: #CBD5E1;
}
QPushButton#primaryBtn {
    background-color: #3B82F6;
    color: #FFFFFF;
    border: none;
    font-weight: bold;
}
QPushButton#primaryBtn:hover {
    background-color: #2563EB;
}
QPushButton#primaryBtn:pressed {
    background-color: #1D4ED8;
}
QPushButton#themeToggleBtn {
    background: transparent;
    border: 1px solid rgba(255,255,255,0.3);
    color: rgba(255,255,255,0.9);
    border-radius: 6px;
    padding: 4px 12px;
    min-height: 28px;
    font-size: 12px;
}
QPushButton#themeToggleBtn:hover {
    background: rgba(255,255,255,0.15);
}

/* ----- Input Fields ----- */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QDateEdit, QTimeEdit {
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 8px 12px;
    min-height: 40px;
    background-color: #FFFFFF;
    color: #1E293B;
    selection-background-color: #DBEAFE;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus, QDateEdit:focus {
    border: 2px solid #3B82F6;
    padding: 7px 11px;
}
QComboBox::drop-down {
    border: none;
    padding-right: 8px;
}
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    selection-background-color: #DBEAFE;
}

/* ----- Tables ----- */
QTableWidget {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    gridline-color: #F1F5F9;
    selection-background-color: #DBEAFE;
    alternate-background-color: #F8FAFC;
    outline: none;
}
QTableWidget::item {
    padding: 6px 10px;
    min-height: 20px;
}
QHeaderView::section {
    background-color: #F1F5F9;
    border: none;
    border-bottom: 2px solid #E2E8F0;
    padding: 8px 12px;
    font-weight: bold;
    color: #475569;
    min-height: 20px;
}

/* ----- Scroll Bars ----- */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #CBD5E1;
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #94A3B8;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 8px;
}
QScrollBar::handle:horizontal {
    background: #CBD5E1;
    border-radius: 4px;
    min-width: 30px;
}

/* ----- Tabs ----- */
QTabWidget::pane {
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    background: #FFFFFF;
}
QTabBar::tab {
    background: #F1F5F9;
    border: 1px solid #E2E8F0;
    padding: 8px 16px;
    margin-right: 2px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    min-height: 28px;
}
QTabBar::tab:selected {
    background: #FFFFFF;
    border-bottom-color: #FFFFFF;
    color: #3B82F6;
    font-weight: bold;
}

/* ----- Group Box ----- */
QGroupBox {
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    margin-top: 12px;
    padding: 16px 12px 12px 12px;
    font-weight: bold;
    color: #475569;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 16px;
    padding: 0 6px;
}

/* ----- Menu Bar ----- */
QMenuBar {
    background-color: #F1F5F9;
    border-bottom: 1px solid #E2E8F0;
    padding: 2px;
    color: #334155;
}
QMenuBar::item:selected {
    background-color: #DBEAFE;
    border-radius: 6px;
    color: #1D4ED8;
}
QMenu {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    padding: 4px;
}
QMenu::item {
    padding: 8px 32px 8px 16px;
    border-radius: 6px;
}
QMenu::item:selected {
    background-color: #DBEAFE;
    color: #1D4ED8;
}

/* ----- Status Bar ----- */
QStatusBar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1E40AF, stop:1 #3B82F6);
    color: #FFFFFF;
    min-height: 40px;
    font-size: 12px;
    border-top: 1px solid #1D4ED8;
}
QStatusBar QLabel {
    color: rgba(255,255,255,0.9);
    padding: 0 8px;
}
#versionLabel {
    color: rgba(255,255,255,0.7);
    font-size: 11px;
}

/* ----- Text Edit ----- */
QTextEdit, QPlainTextEdit {
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 8px;
    background-color: #FFFFFF;
    selection-background-color: #DBEAFE;
}
QTextEdit:focus, QPlainTextEdit:focus {
    border: 2px solid #3B82F6;
}

/* ----- Progress Bar ----- */
QProgressBar {
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    text-align: center;
    height: 20px;
    background: #F1F5F9;
}
QProgressBar::chunk {
    background: #3B82F6;
    border-radius: 5px;
}

/* ----- Tooltips ----- */
QToolTip {
    background: #1E293B;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}
