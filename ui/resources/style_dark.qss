/* Smart Accounting Platform — Dark Theme (Material Design 3) */
/* ============================================================ */

/* ----- Global ----- */
QMainWindow {
    background-color: #121212;
}
QWidget {
    font-family: "Segoe UI", "Tahoma", "Arial", sans-serif;
    font-size: 13px;
    color: #E0E0E0;
}

/* ----- Top Header Bar ----- */
#headerBar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1A237E, stop:1 #283593);
    min-height: 52px;
    max-height: 52px;
    border-bottom: 2px solid #3949AB;
    padding: 0 16px;
}
#headerBar QLabel {
    color: #FFFFFF;
    font-size: 16px;
    font-weight: bold;
}
#headerBar QLabel#headerSub {
    color: rgba(255,255,255,0.7);
    font-size: 11px;
    font-weight: normal;
}

/* ----- Sidebar ----- */
#sidebar {
    background: #181818;
    border: none;
    border-right: 1px solid rgba(255,255,255,0.06);
    padding: 8px 4px;
    font-size: 13px;
    outline: none;
}
#sidebar::item {
    padding: 8px 12px;
    margin: 1px 6px;
    border-radius: 8px;
    color: #B0B0B0;
    min-height: 20px;
}
#sidebar::item:hover {
    background-color: rgba(255,255,255,0.06);
    color: #E0E0E0;
}
#sidebar::item:selected {
    background-color: rgba(144,202,249,0.15);
    color: #90CAF9;
    font-weight: bold;
    border-left: 3px solid #64B5F6;
}

/* ----- Ribbon (تبويبات فوق + أزرار تحتها) ----- */
#ribbonWidget {
    background-color: #181818;
    border-bottom: 1px solid rgba(255,255,255,0.06);
}
#ribbonTabs {
    background: transparent;
    border: none;
    padding: 0 8px;
    font-size: 12px;
    outline: none;
}
#ribbonTabs::tab {
    background: transparent;
    color: #B0B0B0;
    padding: 5px 14px;
    border: none;
    border-bottom: 3px solid transparent;
    margin: 2px 0;
    min-height: 34px;
}
#ribbonTabs::tab:hover {
    background-color: rgba(255,255,255,0.06);
    color: #E0E0E0;
}
#ribbonTabs::tab:selected {
    color: #90CAF9;
    font-weight: bold;
    border-bottom: 3px solid #64B5F6;
}
#ribbonBtn {
    background: transparent;
    border: none;
    border-radius: 8px;
    color: #B0B0B0;
    font-size: 11px;
    padding: 2px 8px;
}
#ribbonBtn:hover {
    background-color: rgba(255,255,255,0.06);
    color: #E0E0E0;
}
#ribbonBtn:pressed {
    background-color: rgba(144,202,249,0.15);
    color: #90CAF9;
}

/* ----- Content Area ----- */
#contentStack {
    background-color: #121212;
}

/* ----- Cards ----- */
QFrame#card {
    background-color: #1E1E1E;
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 10px;
    padding: 12px;
}
QFrame#card:hover {
    border-color: rgba(255,255,255,0.10);
}

/* ----- Headers ----- */
#headerTitle {
    font-size: 22px;
    font-weight: bold;
    color: #FFFFFF;
    padding: 4px 0 2px 0;
}
#headerSubtitle {
    font-size: 13px;
    color: #9E9E9E;
    padding: 0 0 12px 0;
}
#cardTitle {
    font-size: 14px;
    font-weight: bold;
    color: #E0E0E0;
    padding-bottom: 6px;
}

/* ----- Stat Cards ----- */
#statValue {
    font-size: 22px;
    font-weight: bold;
    color: #64B5F6;
}

/* ----- Buttons ----- */
QPushButton {
    background-color: #2C2C2C;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 8px;
    padding: 8px 18px;
    min-height: 40px;
    color: #CCCCCC;
    font-weight: 500;
}
QPushButton:hover {
    background-color: #383838;
    border-color: rgba(255,255,255,0.15);
}
QPushButton:pressed {
    background-color: #444444;
}
QPushButton#primaryBtn {
    background-color: #64B5F6;
    color: #121212;
    border: none;
    font-weight: bold;
}
QPushButton#primaryBtn:hover {
    background-color: #42A5F5;
}
QPushButton#primaryBtn:pressed {
    background-color: #1E88E5;
}
QPushButton#themeToggleBtn {
    background: transparent;
    border: 1px solid rgba(255,255,255,0.2);
    color: rgba(255,255,255,0.85);
    border-radius: 6px;
    padding: 4px 12px;
    min-height: 28px;
    font-size: 12px;
}
QPushButton#themeToggleBtn:hover {
    background: rgba(255,255,255,0.1);
}

/* ----- Input Fields ----- */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QDateEdit, QTimeEdit {
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 8px;
    padding: 8px 12px;
    min-height: 40px;
    background-color: #1A1A1A;
    color: #E0E0E0;
    selection-background-color: rgba(100,181,246,0.3);
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus, QDateEdit:focus {
    border: 2px solid #64B5F6;
    padding: 7px 11px;
}
QComboBox::drop-down {
    border: none;
    padding-right: 8px;
}
QComboBox QAbstractItemView {
    background-color: #1E1E1E;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 6px;
    selection-background-color: rgba(100,181,246,0.2);
    color: #E0E0E0;
}

/* ----- Tables ----- */
QTableWidget {
    background-color: #1A1A1A;
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 8px;
    gridline-color: rgba(255,255,255,0.03);
    selection-background-color: rgba(100,181,246,0.15);
    alternate-background-color: #1E1E1E;
    outline: none;
}
QTableWidget::item {
    padding: 6px 10px;
    min-height: 20px;
}
QHeaderView::section {
    background-color: #212121;
    border: none;
    border-bottom: 2px solid rgba(255,255,255,0.08);
    padding: 8px 12px;
    font-weight: bold;
    color: #90CAF9;
    min-height: 20px;
}

/* ----- Scroll Bars ----- */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: rgba(255,255,255,0.15);
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: rgba(255,255,255,0.25);
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 8px;
}
QScrollBar::handle:horizontal {
    background: rgba(255,255,255,0.15);
    border-radius: 4px;
    min-width: 30px;
}

/* ----- Tabs ----- */
QTabWidget::pane {
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 8px;
    background: #1E1E1E;
}
QTabBar::tab {
    background: #2C2C2C;
    border: 1px solid rgba(255,255,255,0.06);
    padding: 8px 16px;
    margin-right: 2px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    min-height: 28px;
    color: #9E9E9E;
}
QTabBar::tab:selected {
    background: #1E1E1E;
    border-bottom-color: #1E1E1E;
    color: #64B5F6;
    font-weight: bold;
}

/* ----- Group Box ----- */
QGroupBox {
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 10px;
    margin-top: 12px;
    padding: 16px 12px 12px 12px;
    font-weight: bold;
    color: #B0B0B0;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 16px;
    padding: 0 6px;
}

/* ----- Menu Bar ----- */
QMenuBar {
    background-color: #181818;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    padding: 2px;
    color: #CCCCCC;
}
QMenuBar::item:selected {
    background-color: rgba(100,181,246,0.15);
    border-radius: 6px;
    color: #90CAF9;
}
QMenu {
    background-color: #1E1E1E;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 10px;
    padding: 4px;
}
QMenu::item {
    padding: 8px 32px 8px 16px;
    border-radius: 6px;
}
QMenu::item:selected {
    background-color: rgba(100,181,246,0.15);
    color: #90CAF9;
}

/* ----- Status Bar ----- */
QStatusBar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1A237E, stop:1 #283593);
    color: #FFFFFF;
    min-height: 40px;
    font-size: 12px;
    border-top: 1px solid #3949AB;
}
QStatusBar QLabel {
    color: rgba(255,255,255,0.85);
    padding: 0 8px;
}
#versionLabel {
    color: rgba(255,255,255,0.6);
    font-size: 11px;
}

/* ----- Text Edit ----- */
QTextEdit, QPlainTextEdit {
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 8px;
    padding: 8px;
    background-color: #1A1A1A;
    selection-background-color: rgba(100,181,246,0.3);
    color: #E0E0E0;
}
QTextEdit:focus, QPlainTextEdit:focus {
    border: 2px solid #64B5F6;
}

/* ----- Progress Bar ----- */
QProgressBar {
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 6px;
    text-align: center;
    height: 20px;
    background: #2C2C2C;
    color: #E0E0E0;
}
QProgressBar::chunk {
    background: #64B5F6;
    border-radius: 5px;
}

/* ----- Tooltips ----- */
QToolTip {
    background: #424242;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}
