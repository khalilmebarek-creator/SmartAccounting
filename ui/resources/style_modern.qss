/* ============================================
   🌌 Modern Glassmorphism Theme
   ============================================
   - Gradient background (deep purple → midnight)
   - Glassmorphism cards (frosted glass effect)
   - Vibrant accent gradients (cyan → blue → pink)
   - Subtle glow on hover
   ============================================ */

/* === Global Reset === */
* {
    font-family: 'Segoe UI', 'Tahoma', 'Arial', sans-serif;
    color: #FFFFFF;
}

QWidget {
    background-color: transparent;
    font-size: 10pt;
}

/* === Main Window Background === */
/* Deep cosmic gradient: purple → indigo → midnight */
QMainWindow {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #0F0C29,
        stop:0.5 #302B63,
        stop:1 #24243E
    );
}

/* Central widget — slightly translucent to show gradient */
QWidget#centralWidget,
QStackedWidget,
QStackedWidget > QWidget {
    background-color: transparent;
}

/* === Sidebar (Glass Panel) === */
QListWidget#sidebar {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(15, 15, 35, 220),
        stop:1 rgba(36, 36, 62, 200)
    );
    border: none;
    border-right: 1px solid rgba(255, 255, 255, 30);
    padding: 12px 0;
    font-size: 11pt;
    outline: 0;
}

QListWidget#sidebar::item {
    padding: 14px 20px;
    margin: 4px 10px;
    border-radius: 10px;
    color: #B8B8D4;
    border: 1px solid transparent;
}

QListWidget#sidebar::item:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(0, 210, 255, 30),
        stop:1 rgba(123, 47, 247, 30)
    );
    color: #FFFFFF;
    border: 1px solid rgba(0, 210, 255, 80);
}

QListWidget#sidebar::item:selected {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #00D2FF,
        stop:0.5 #7B2FF7,
        stop:1 #FF6B9D
    );
    color: #FFFFFF;
    font-weight: bold;
    border: 1px solid rgba(255, 255, 255, 100);
    border-left: 4px solid #FFFFFF;
}

/* === Menu Bar (Glass) === */
QMenuBar {
    background: rgba(15, 15, 35, 180);
    color: #FFFFFF;
    padding: 6px;
    border-bottom: 1px solid rgba(255, 255, 255, 20);
}

QMenuBar::item {
    background-color: transparent;
    padding: 6px 16px;
    border-radius: 6px;
}

QMenuBar::item:selected {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(0, 210, 255, 80),
        stop:1 rgba(123, 47, 247, 80)
    );
    color: #FFFFFF;
}

QMenu {
    background-color: #1A1A2E;
    border: 1px solid rgba(0, 210, 255, 50);
    border-radius: 8px;
    color: #FFFFFF;
}

QMenu::item {
    padding: 8px 30px;
}

QMenu::item:selected {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #00D2FF,
        stop:1 #7B2FF7
    );
    color: #FFFFFF;
}

/* === Group Box (Glass Card) === */
QGroupBox {
    background: rgba(255, 255, 255, 8);
    border: 1px solid rgba(255, 255, 255, 30);
    border-radius: 12px;
    margin-top: 14px;
    padding: 16px 14px 14px 14px;
    font-weight: bold;
    color: #FFFFFF;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top right;
    padding: 4px 14px;
    color: #FFFFFF;
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #00D2FF,
        stop:1 #7B2FF7
    );
    border-radius: 6px;
    font-weight: bold;
}

/* === Buttons (Gradient + Glow) === */
QPushButton {
    padding: 0 22px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 10pt;
    border: 1px solid rgba(255, 255, 255, 30);
    background: rgba(255, 255, 255, 20);
    color: #FFFFFF;
    min-width: 100px;
    min-height: 40px;
}

QPushButton:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(0, 210, 255, 60),
        stop:1 rgba(123, 47, 247, 60)
    );
    border: 1px solid rgba(0, 210, 255, 120);
}

QPushButton:pressed {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #00B8E6,
        stop:1 #6A2FD7
    );
}

QPushButton:disabled {
    background: rgba(255, 255, 255, 10);
    color: rgba(255, 255, 255, 80);
    border: 1px solid rgba(255, 255, 255, 10);
}

QPushButton:focus {
    border: 2px solid #00D2FF;
}

QPushButton#primaryBtn {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #00D2FF,
        stop:1 #3A47D5
    );
    color: #FFFFFF;
    border: none;
    font-weight: bold;
}

QPushButton#primaryBtn:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #1AE0FF,
        stop:1 #4A57E5
    );
}

QPushButton#primaryBtn:pressed {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #00B8E6,
        stop:1 #2A37C5
    );
}

QPushButton#successBtn {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #00F5A0,
        stop:1 #00D9F5
    );
    color: #003322;
    border: none;
    font-weight: bold;
}

QPushButton#successBtn:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #2DFFB8,
        stop:1 #2DE5FF
    );
}

QPushButton#dangerBtn {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #FF6B9D,
        stop:1 #FF3838
    );
    color: #FFFFFF;
    border: none;
    font-weight: bold;
}

QPushButton#dangerBtn:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #FF85B5,
        stop:1 #FF5050
    );
}

QPushButton#secondaryBtn {
    background: rgba(255, 255, 255, 15);
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 40);
}

QPushButton#secondaryBtn:hover {
    background: rgba(255, 255, 255, 25);
    border: 1px solid rgba(0, 210, 255, 80);
}

/* === Input Fields (Glass) === */
QLineEdit, QDoubleSpinBox, QSpinBox, QTextEdit, QPlainTextEdit {
    padding: 0 14px;
    border: 1px solid rgba(255, 255, 255, 25);
    border-radius: 8px;
    background: rgba(255, 255, 255, 12);
    color: #FFFFFF;
    selection-background-color: #00D2FF;
    selection-color: #003366;
    min-height: 40px;
}

QLineEdit:focus, QDoubleSpinBox:focus, QSpinBox:focus,
QTextEdit:focus, QPlainTextEdit:focus {
    border: 2px solid #00D2FF;
    background: rgba(0, 210, 255, 12);
}

QLineEdit:disabled, QDoubleSpinBox:disabled, QSpinBox:disabled {
    color: rgba(255, 255, 255, 60);
    background: rgba(255, 255, 255, 5);
}

QDoubleSpinBox::up-button, QSpinBox::up-button,
QDoubleSpinBox::down-button, QSpinBox::down-button {
    background: rgba(255, 255, 255, 15);
    border: none;
    width: 18px;
}

QDoubleSpinBox::up-button:hover, QSpinBox::up-button:hover,
QDoubleSpinBox::down-button:hover, QSpinBox::down-button:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #00D2FF,
        stop:1 #7B2FF7
    );
}

/* === Labels === */
QLabel {
    background: transparent;
    color: #FFFFFF;
}

QLabel#headerTitle {
    font-size: 22pt;
    font-weight: bold;
    color: #FFFFFF;
    padding: 10px 5px;
    background: transparent;
}

QLabel#headerSubtitle {
    font-size: 11pt;
    color: #B8B8D4;
    padding: 0 5px 10px 5px;
    background: transparent;
}

QLabel#sectionTitle {
    font-size: 14pt;
    font-weight: bold;
    color: #FFFFFF;
    padding: 8px 0;
    background: transparent;
}

QLabel#cardTitle {
    font-size: 10pt;
    color: #B8B8D4;
    font-weight: 600;
    background: transparent;
}

QLabel#cardValue {
    font-size: 22pt;
    font-weight: bold;
    color: #FFFFFF;
    background: transparent;
}

QLabel#cardValueGood { color: #00F5A0; background: transparent; }
QLabel#cardValueWarning { color: #FFB347; background: transparent; }
QLabel#cardValueBad { color: #FF6B9D; background: transparent; }

/* === Cards (Glassmorphism) === */
QFrame#card {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(255, 255, 255, 18),
        stop:1 rgba(255, 255, 255, 8)
    );
    border: 1px solid rgba(255, 255, 255, 30);
    border-radius: 14px;
    padding: 16px;
}

QFrame#card:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(0, 210, 255, 25),
        stop:1 rgba(123, 47, 247, 18)
    );
    border: 1px solid rgba(0, 210, 255, 80);
}

/* === Tables === */
QTableWidget, QTableView {
    background: rgba(255, 255, 255, 8);
    border: 1px solid rgba(255, 255, 255, 25);
    border-radius: 8px;
    gridline-color: rgba(255, 255, 255, 15);
    color: #FFFFFF;
    alternate-background-color: rgba(255, 255, 255, 4);
}

QTableWidget::item, QTableView::item {
    padding: 10px;
    color: #FFFFFF;
}

QTableWidget::item:selected, QTableView::item:selected {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(0, 210, 255, 100),
        stop:1 rgba(123, 47, 247, 100)
    );
    color: #FFFFFF;
}

QHeaderView::section {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #302B63,
        stop:1 #24243E
    );
    color: #FFFFFF;
    padding: 12px 10px;
    border: none;
    font-weight: bold;
    border-right: 1px solid rgba(255, 255, 255, 15);
}

QHeaderView::section:first {
    border-top-left-radius: 8px;
}

QHeaderView::section:last {
    border-top-right-radius: 8px;
    border-right: none;
}

/* === Combo Box === */
QComboBox {
    padding: 0 14px;
    border: 1px solid rgba(255, 255, 255, 25);
    border-radius: 8px;
    background: rgba(255, 255, 255, 12);
    color: #FFFFFF;
    min-width: 120px;
    min-height: 40px;
}

QComboBox:hover {
    border: 1px solid rgba(0, 210, 255, 80);
    background: rgba(0, 210, 255, 12);
}

QComboBox:focus {
    border: 2px solid #00D2FF;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox QAbstractItemView {
    background-color: #1A1A2E;
    border: 1px solid rgba(0, 210, 255, 50);
    border-radius: 8px;
    color: #FFFFFF;
    selection-background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #00D2FF,
        stop:1 #7B2FF7
    );
}

/* === Checkbox / Radio === */
QCheckBox, QRadioButton {
    color: #FFFFFF;
    spacing: 8px;
    background: transparent;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid rgba(255, 255, 255, 40);
    border-radius: 4px;
    background: rgba(255, 255, 255, 10);
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #00D2FF,
        stop:1 #7B2FF7
    );
    border: 2px solid #00D2FF;
}

QRadioButton::indicator {
    border-radius: 9px;
}

/* === Scroll Bars === */
QScrollBar:vertical {
    background: rgba(255, 255, 255, 5);
    width: 10px;
    border-radius: 5px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #00D2FF,
        stop:1 #7B2FF7
    );
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #1AE0FF,
        stop:1 #8B3FFF
    );
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: rgba(255, 255, 255, 5);
    height: 10px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 #00D2FF,
        stop:1 #7B2FF7
    );
    border-radius: 5px;
    min-width: 30px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

/* === Status Bar === */
QStatusBar {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(15, 15, 35, 220),
        stop:1 rgba(36, 36, 62, 220)
    );
    color: #FFFFFF;
    padding: 6px 14px;
    border-top: 1px solid rgba(255, 255, 255, 20);
    font-weight: 500;
}

QStatusBar::item {
    border: none;
}

/* === Text Browser (Reports) === */
QTextBrowser, QTextEdit {
    background: rgba(255, 255, 255, 8);
    border: 1px solid rgba(255, 255, 255, 25);
    border-radius: 10px;
    padding: 18px;
    font-family: 'Consolas', 'Courier New', monospace;
    font-size: 10pt;
    line-height: 1.5;
    color: #FFFFFF;
}

/* === Tab Widget === */
QTabWidget::pane {
    border: 1px solid rgba(255, 255, 255, 20);
    border-radius: 10px;
    background: rgba(255, 255, 255, 6);
    top: -1px;
}

QTabBar::tab {
    background: rgba(255, 255, 255, 8);
    color: #B8B8D4;
    padding: 10px 22px;
    margin-right: 4px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border: 1px solid transparent;
}

QTabBar::tab:hover {
    background: rgba(0, 210, 255, 25);
    color: #FFFFFF;
}

QTabBar::tab:selected {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #00D2FF,
        stop:1 #7B2FF7
    );
    color: #FFFFFF;
    font-weight: bold;
}

/* === Progress Bar === */
QProgressBar {
    background: rgba(255, 255, 255, 10);
    border: 1px solid rgba(255, 255, 255, 25);
    border-radius: 6px;
    text-align: center;
    color: #FFFFFF;
    height: 20px;
}

QProgressBar::chunk {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #00D2FF,
        stop:0.5 #7B2FF7,
        stop:1 #FF6B9D
    );
    border-radius: 5px;
}

/* === Tooltip === */
QToolTip {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #1A1A2E,
        stop:1 #302B63
    );
    color: #FFFFFF;
    border: 1px solid #00D2FF;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 9pt;
}

/* === Splitter === */
QSplitter::handle {
    background: rgba(255, 255, 255, 15);
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

/* === Message Box === */
QMessageBox {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #0F0C29,
        stop:1 #24243E
    );
    color: #FFFFFF;
}

QMessageBox QLabel {
    color: #FFFFFF;
}

QMessageBox QPushButton {
    min-width: 80px;
    padding: 6px 16px;
}

/* === Input Dialog === */
QInputDialog {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #0F0C29,
        stop:1 #24243E
    );
    color: #FFFFFF;
}

QInputDialog QLabel {
    color: #FFFFFF;
}

/* === Calendar === */
QCalendarWidget {
    background: #1A1A2E;
    color: #FFFFFF;
}

QCalendarWidget QToolButton {
    color: #FFFFFF;
    background: transparent;
    padding: 8px;
    border-radius: 4px;
}

QCalendarWidget QToolButton:hover {
    background: rgba(0, 210, 255, 40);
}

/* === List Widget (general, not sidebar) === */
QListWidget {
    background: rgba(255, 255, 255, 8);
    border: 1px solid rgba(255, 255, 255, 25);
    border-radius: 8px;
    color: #FFFFFF;
    padding: 6px;
}

QListWidget::item {
    padding: 10px;
    border-radius: 6px;
    color: #FFFFFF;
}

QListWidget::item:selected {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #00D2FF,
        stop:1 #7B2FF7
    );
    color: #FFFFFF;
}

/* === Tool Bar === */
QToolBar {
    background: rgba(15, 15, 35, 180);
    border: none;
    spacing: 4px;
    padding: 4px;
}

QToolBar::separator {
    background: rgba(255, 255, 255, 20);
    width: 1px;
    margin: 4px;
}

/* === Special: Cards with positive trend === */
QLabel#trendUp {
    color: #00F5A0;
    font-weight: bold;
    background: transparent;
}

QLabel#trendDown {
    color: #FF6B9D;
    font-weight: bold;
    background: transparent;
}
