/* Smart Accounting Platform — Modern Theme (Glass + Cosmic) */
/* ============================================================ */

/* ----- Global ----- */
QMainWindow {
    background-color: #0A0A1A;
}
QWidget {
    font-family: "Segoe UI", "Tahoma", "Arial", sans-serif;
    font-size: 13px;
    color: #E0E0F0;
}

/* ----- Top Header Bar ----- */
#headerBar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #4A148C, stop:0.5 #6A1B9A, stop:1 #7C4DFF);
    min-height: 52px;
    max-height: 52px;
    border-bottom: 2px solid rgba(124,77,255,0.4);
    padding: 0 16px;
}
#headerBar QLabel {
    color: #FFFFFF;
    font-size: 16px;
    font-weight: bold;
}
#headerBar QLabel#headerSub {
    color: rgba(255,255,255,0.75);
    font-size: 11px;
    font-weight: normal;
}

/* ----- Sidebar ----- */
#sidebar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 rgba(15,15,35,0.95), stop:1 rgba(10,10,30,0.98));
    border: none;
    border-right: 1px solid rgba(124,77,255,0.15);
    padding: 8px 4px;
    font-size: 13px;
    outline: none;
}
#sidebar::item {
    padding: 8px 12px;
    margin: 1px 6px;
    border-radius: 8px;
    color: rgba(200,200,230,0.7);
    min-height: 20px;
    background: transparent;
}
#sidebar::item:hover {
    background-color: rgba(124,77,255,0.1);
    color: rgba(220,220,255,0.95);
}
#sidebar::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 rgba(124,77,255,0.25), stop:1 rgba(0,200,255,0.15));
    color: #FFFFFF;
    font-weight: bold;
    border-left: 3px solid #7C4DFF;
}

/* ----- Ribbon (تبويبات فوق + أزرار تحتها) ----- */
#ribbonWidget {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 rgba(15,15,35,0.95), stop:1 rgba(20,20,45,0.98));
    border-bottom: 1px solid rgba(124,77,255,0.15);
}
#ribbonTabs {
    background: transparent;
    border: none;
    padding: 0 8px;
    font-size: 12px;
    outline: none;
}
#ribbonTabs::tab {
    background: transparent;
    color: rgba(200,200,230,0.7);
    padding: 5px 14px;
    border: none;
    border-bottom: 3px solid transparent;
    margin: 2px 0;
    min-height: 34px;
}
#ribbonTabs::tab:hover {
    background-color: rgba(124,77,255,0.1);
    color: rgba(220,220,255,0.95);
}
#ribbonTabs::tab:selected {
    color: #FFFFFF;
    font-weight: bold;
    border-bottom: 3px solid #7C4DFF;
}
#ribbonBtn {
    background: transparent;
    border: none;
    border-radius: 8px;
    color: rgba(200,200,230,0.7);
    font-size: 11px;
    padding: 2px 8px;
}
#ribbonBtn:hover {
    background-color: rgba(124,77,255,0.1);
    color: rgba(220,220,255,0.95);
}
#ribbonBtn:pressed {
    background-color: rgba(124,77,255,0.25);
    color: #FFFFFF;
}

/* ----- Content Area ----- */
#contentStack {
    background-color: #0A0A1A;
}

/* ----- Cards (Glass Effect) ----- */
QFrame#card {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 rgba(255,255,255,0.04), stop:1 rgba(255,255,255,0.01));
    border: 1px solid rgba(124,77,255,0.1);
    border-radius: 12px;
    padding: 12px;
}
QFrame#card:hover {
    border-color: rgba(124,77,255,0.2);
}

/* ----- Headers ----- */
#headerTitle {
    font-size: 22px;
    font-weight: bold;
    color: #FFFFFF;
    padding: 4px 0 2px 0;
}
#headerSubtitle {
    font-size: 13px;
    color: rgba(200,200,220,0.6);
    padding: 0 0 12px 0;
}
#cardTitle {
    font-size: 14px;
    font-weight: bold;
    color: #E0E0F0;
    padding-bottom: 6px;
}

/* ----- Stat Cards ----- */
#statValue {
    font-size: 22px;
    font-weight: bold;
    color: #7C4DFF;
}

/* ----- Buttons ----- */
QPushButton {
    background-color: rgba(255,255,255,0.04);
    border: 1px solid rgba(124,77,255,0.15);
    border-radius: 8px;
    padding: 8px 18px;
    min-height: 40px;
    color: rgba(200,200,230,0.85);
    font-weight: 500;
}
QPushButton:hover {
    background-color: rgba(124,77,255,0.1);
    border-color: rgba(124,77,255,0.3);
}
QPushButton:pressed {
    background-color: rgba(124,77,255,0.2);
}
QPushButton#primaryBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #7C4DFF, stop:1 #448AFF);
    color: #FFFFFF;
    border: none;
    font-weight: bold;
}
QPushButton#primaryBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #651FFF, stop:1 #2979FF);
}
QPushButton#primaryBtn:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #6200EA, stop:1 #2962FF);
}
QPushButton#themeToggleBtn {
    background: transparent;
    border: 1px solid rgba(124,77,255,0.3);
    color: rgba(255,255,255,0.85);
    border-radius: 6px;
    padding: 4px 12px;
    min-height: 28px;
    font-size: 12px;
}
QPushButton#themeToggleBtn:hover {
    background: rgba(124,77,255,0.15);
}

/* ----- Input Fields ----- */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QDateEdit, QTimeEdit {
    border: 1px solid rgba(124,77,255,0.12);
    border-radius: 8px;
    padding: 8px 12px;
    min-height: 40px;
    background-color: rgba(255,255,255,0.03);
    color: #E0E0F0;
    selection-background-color: rgba(124,77,255,0.4);
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus, QDateEdit:focus {
    border: 2px solid #7C4DFF;
    padding: 7px 11px;
    background-color: rgba(124,77,255,0.05);
}
QComboBox::drop-down {
    border: none;
    padding-right: 8px;
}
QComboBox QAbstractItemView {
    background-color: #12122A;
    border: 1px solid rgba(124,77,255,0.15);
    border-radius: 6px;
    selection-background-color: rgba(124,77,255,0.2);
    color: #E0E0F0;
}

/* ----- Tables ----- */
QTableWidget {
    background-color: rgba(255,255,255,0.02);
    border: 1px solid rgba(124,77,255,0.08);
    border-radius: 8px;
    gridline-color: rgba(255,255,255,0.02);
    selection-background-color: rgba(124,77,255,0.15);
    alternate-background-color: rgba(255,255,255,0.015);
    outline: none;
}
QTableWidget::item {
    padding: 6px 10px;
    min-height: 20px;
}
QHeaderView::section {
    background-color: rgba(124,77,255,0.08);
    border: none;
    border-bottom: 2px solid rgba(124,77,255,0.15);
    padding: 8px 12px;
    font-weight: bold;
    color: #B39DDB;
    min-height: 20px;
}

/* ----- Scroll Bars ----- */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: rgba(124,77,255,0.2);
    border-radius: 4px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: rgba(124,77,255,0.35);
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
QScrollBar:horizontal {
    background: transparent;
    height: 8px;
}
QScrollBar::handle:horizontal {
    background: rgba(124,77,255,0.2);
    border-radius: 4px;
    min-width: 30px;
}

/* ----- Tabs ----- */
QTabWidget::pane {
    border: 1px solid rgba(124,77,255,0.1);
    border-radius: 8px;
    background: rgba(255,255,255,0.02);
}
QTabBar::tab {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(124,77,255,0.1);
    padding: 8px 16px;
    margin-right: 2px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    min-height: 28px;
    color: rgba(200,200,220,0.6);
}
QTabBar::tab:selected {
    background: rgba(124,77,255,0.1);
    border-bottom-color: transparent;
    color: #B39DDB;
    font-weight: bold;
}

/* ----- Group Box ----- */
QGroupBox {
    border: 1px solid rgba(124,77,255,0.1);
    border-radius: 10px;
    margin-top: 12px;
    padding: 16px 12px 12px 12px;
    font-weight: bold;
    color: #B39DDB;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 16px;
    padding: 0 6px;
}

/* ----- Menu Bar ----- */
QMenuBar {
    background-color: rgba(10,10,30,0.95);
    border-bottom: 1px solid rgba(124,77,255,0.1);
    padding: 2px;
    color: rgba(200,200,220,0.8);
}
QMenuBar::item:selected {
    background-color: rgba(124,77,255,0.15);
    border-radius: 6px;
    color: #B39DDB;
}
QMenu {
    background-color: #12122A;
    border: 1px solid rgba(124,77,255,0.15);
    border-radius: 10px;
    padding: 4px;
}
QMenu::item {
    padding: 8px 32px 8px 16px;
    border-radius: 6px;
}
QMenu::item:selected {
    background-color: rgba(124,77,255,0.15);
    color: #B39DDB;
}

/* ----- Status Bar ----- */
QStatusBar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #4A148C, stop:0.5 #6A1B9A, stop:1 #7C4DFF);
    color: #FFFFFF;
    min-height: 40px;
    font-size: 12px;
    border-top: 1px solid rgba(124,77,255,0.3);
}
QStatusBar QLabel {
    color: rgba(255,255,255,0.85);
    padding: 0 8px;
}
#versionLabel {
    color: rgba(255,255,255,0.6);
    font-size: 11px;
}

/* ----- Text Edit ----- */
QTextEdit, QPlainTextEdit {
    border: 1px solid rgba(124,77,255,0.12);
    border-radius: 8px;
    padding: 8px;
    background-color: rgba(255,255,255,0.02);
    selection-background-color: rgba(124,77,255,0.4);
    color: #E0E0F0;
}
QTextEdit:focus, QPlainTextEdit:focus {
    border: 2px solid #7C4DFF;
}

/* ----- Progress Bar ----- */
QProgressBar {
    border: 1px solid rgba(124,77,255,0.12);
    border-radius: 6px;
    text-align: center;
    height: 20px;
    background: rgba(255,255,255,0.03);
    color: #E0E0F0;
}
QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #7C4DFF, stop:1 #448AFF);
    border-radius: 5px;
}

/* ----- Tooltips ----- */
QToolTip {
    background: rgba(30,30,60,0.95);
    color: #FFFFFF;
    border: 1px solid rgba(124,77,255,0.2);
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}
